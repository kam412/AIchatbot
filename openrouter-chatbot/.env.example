# Copy this file to ".env" and fill in your own key.
# Get a FREE key (no credit card required) at https://openrouter.ai/keys

OPENROUTER_API_KEY=your-api-key-here

# Optional — defaults to a free Llama model if omitted.
# Browse other free models (they end in ":free") at https://openrouter.ai/models
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional — defaults to 3000
PORT=3000
